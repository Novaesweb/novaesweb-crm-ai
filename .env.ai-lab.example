# Copy to .env.ai-lab locally; NEVER commit the real file.
# The lab starts with sending DISABLED. Set true only after health + mocked tests pass.
AI_REPLY_ENABLED=false
AI_TEST_ALLOWED_NUMBER=5511999998888
CRM_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRM_LAB_ADMIN_TOKEN=USE_ANOTHER_STRONG_32_CHARACTER_SECRET
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=YOUR_LOCAL_EVOLUTION_KEY
EVOLUTION_INSTANCE=crmtest
# v2 generally expects {number,text}; legacy expects {number,textMessage:{text}}.
EVOLUTION_SEND_FORMAT=v2
# Must be an OpenAI-compatible BASE URL ending in /v1 (chat/completions appended).
AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
AI_MODEL=openrouter/free
AI_BUSINESS_CONTEXT=Somos uma empresa de demonstração. Horário: 9h às 17h. Valores e disponibilidade devem ser confirmados com atendimento humano.

# Store authenticated inbound messages for 7 days ONLY after privacy and instance review.
# Capture remains disabled until deliberately enabled on the local computer.
CRM_INBOX_CAPTURE_ENABLED=false

# Optional approved OmniRoute routes, comma-separated; blank disables app-level fallback.
# Do not add models before confirming FREE quotas and provider policy in OmniRoute.
AI_FALLBACK_MODELS=

# Supabase Auth + tenant-scoped operator portal (/operator). Set on local computer.
# Project URL is public, but the publishable key must come from the SAME CRM project.
# Never paste a service_role / secret API key here.
CRM_SUPABASE_URL=https://mpteambmrlflllfqtkmq.supabase.co
CRM_SUPABASE_PUBLISHABLE_KEY=

# Optional durable message ingestion, OFF until webhook, tenant/channel and LGPD are verified.
CRM_SUPABASE_INGEST_ENABLED=false
# Server-side only; do NOT use NEXT_PUBLIC_, commit or paste this credential in chat.
# Required only when CRM_SUPABASE_INGEST_ENABLED=true.
CRM_SUPABASE_SERVICE_ROLE_KEY=

# Master AI provider laboratory: disabled until local keys, free terms and safety reviewed.
# Only explicitly approved free model IDs can be tested; no WhatsApp messages are sent.
CRM_AI_LAB_TEST_ENABLED=false
CRM_AI_LAB_FREE_MODEL_IDS=

CRM_MASTER_PASSWORD=USE_A_STRONG_MASTER_ADMIN_PASSWORD
CRM_MASTER_SESSION_SECRET=SET_A_DEDICATED_STRONG_32_CHAR_SECRET_HERE
# CRM_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
